rules_version = '2';

// 다정초 마음마을 교실 — Firestore 보안 규칙
//
// [divine 클래스] 기존 루트 경로 — 절대 변경 없음:
//   /state/*           학급 공유 데이터 (알림장, 명단 등)
//   /students_v2/{sid} 학생 개인 상태
//   /join_requests/*   입장 신청
//
// [새 클래스] /classes/{classId}/ 하위 경로:
//   /classes/{classId}                    클래스 summary (teacherEmail 쿼리용)
//   /classes/{classId}/info/data          클래스 상세 설정 (ClassInfo)
//   /classes/{classId}/state/*            학급 공유 데이터
//   /classes/{classId}/students_v2/{sid}  학생 개인 상태
//   /classes/{classId}/join_requests/*    입장 신청
//
// 교사 화이트리스트(divine 전용)는 src/data.ts TEACHER_EMAILS와 동일하게 유지할 것.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    // divine 클래스 교사 화이트리스트
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'imogen0716@dajeong.sjedues.kr',
          'hailey@dajeong.sjedues.kr',
          'uyoung98@dajeong.sjedues.kr',
          'unicons89@dajeong.sjedues.kr',
          'njh1312@dajeong.sjedues.kr',
          'jj20223@dajeong.sjedues.kr',
          'imogen0716@gmail.com',
          'uts1368@dajeong.sjedues.kr'
        ];
    }

    // 다정초 도메인 이메일 여부 (새 클래스 교사 개설 자격)
    function isDajeongEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email.matches('.*@dajeong\\.sjedues\\.kr') || isTeacher());
    }

    // 특정 클래스의 담임 교사인지 확인
    function isTeacherOfClass(classId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherEmail == myEmail();
    }

    // divine: 내 이메일에 매핑된 학생 자리(sid)
    function mappedSid() {
      return exists(/databases/$(database)/documents/state/student_email_map)
        ? get(/databases/$(database)/documents/state/student_email_map).data.value[myEmail()]
        : null;
    }

    // 새 클래스: 내 이메일에 매핑된 학생 자리(sid)
    function classMappedSid(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId)/state/student_email_map)
        ? get(/databases/$(database)/documents/classes/$(classId)/state/student_email_map).data.value[myEmail()]
        : null;
    }

    /* ── divine 클래스 (루트 경로 — 변경 없음) ── */

    match /state/{document=**} {
      allow read:  if isAuthed();
      allow write: if isTeacher();
    }

    match /join_requests/{email} {
      allow get:            if isTeacher() || (isAuthed() && myEmail() == email);
      allow list:           if isTeacher();
      allow create, update: if isAuthed() && myEmail() == email && request.resource.data.email == email;
      allow delete:         if isTeacher() || (isAuthed() && myEmail() == email);
    }

    match /students_v2/{sid} {
      allow read:  if isAuthed();
      allow write: if isTeacher() || (isAuthed() && mappedSid() == sid);
    }

    match /gifts/{id} {
      allow read:   if isAuthed();
      allow create: if isAuthed() && request.resource.data.fromSid == mappedSid();
      allow delete: if isTeacher()
                      || mappedSid() == resource.data.toSid
                      || mappedSid() == resource.data.fromSid;
    }

    /* ── 방학 시즌 2 — 모두의 도서관 (gifts와 같은 본인-쓰기 패턴) ── */

    // 도서관 전용 페이지(비밀번호 로그인) 계정: 그 sid 자리의 주인인지 확인.
    // /library_auth/{sid} = { sid, uid, ver, updatedAt } — uid가 현재 로그인한 사용자와 같으면 주인.
    function isLibOwner(sid) {
      return isAuthed()
        && exists(/databases/$(database)/documents/library_auth/$(sid))
        && get(/databases/$(database)/documents/library_auth/$(sid)).data.uid == request.auth.uid;
    }

    // 도서관 비밀번호 자리표 — 로그인 화면에서 인증 전에도 읽어야 해서 read는 공개
    // (내용은 uid·버전뿐, 비밀번호는 Firebase Auth에만 있음)
    match /library_auth/{sid} {
      allow read:   if true;
      allow create: if isTeacher()
                      || (isAuthed()
                          && request.resource.data.sid == sid
                          && request.resource.data.uid == request.auth.uid);
      allow update: if isTeacher()
                      || (isAuthed()
                          && resource.data.uid == null
                          && request.resource.data.sid == sid
                          && request.resource.data.uid == request.auth.uid
                          && request.resource.data.ver == resource.data.ver);
      allow delete: if isTeacher();
    }

    // 좌석·타이머 실시간 상태 — 문서 ID = sid, 본인만 쓰기
    match /library_status/{sid} {
      allow read:  if isAuthed();
      allow write: if isTeacher() || (isAuthed() && mappedSid() == sid) || isLibOwner(sid);
    }

    // 독서 기록 (책 1권 = 문서 1개)
    match /library_records/{id} {
      allow read:           if isAuthed();
      allow create, update: if isTeacher() || (isAuthed() && request.resource.data.sid == mappedSid()) || isLibOwner(request.resource.data.sid);
      allow delete:         if isTeacher() || (isAuthed() && resource.data.sid == mappedSid()) || isLibOwner(resource.data.sid);
    }

    // 독후활동
    match /library_activities/{id} {
      allow read:           if isAuthed();
      allow create, update: if isTeacher() || (isAuthed() && request.resource.data.sid == mappedSid()) || isLibOwner(request.resource.data.sid);
      allow delete:         if isTeacher() || (isAuthed() && resource.data.sid == mappedSid()) || isLibOwner(resource.data.sid);
    }

    /* ── 새 클래스 ── */

    // 클래스 summary 문서 (/classes/{classId})
    // 읽기: 모두 (학생이 반 목록 조회용)
    // 생성: 다정초 이메일이며 teacherEmail == 본인
    // 수정/삭제: 해당 클래스 담임만
    match /classes/{classId} {
      allow read: if isAuthed();
      allow create: if isDajeongEmail()
                      && request.resource.data.teacherEmail == myEmail();
      allow update, delete: if isTeacherOfClass(classId);
    }

    // 클래스 info/data 문서
    match /classes/{classId}/info/{doc} {
      allow read: if isAuthed();
      allow write: if isTeacherOfClass(classId)
                     || (isDajeongEmail() && doc == 'data'
                         && request.resource.data.teacherEmail == myEmail());
    }

    // 클래스 공유 상태 데이터
    match /classes/{classId}/state/{document=**} {
      allow read:  if isAuthed();
      allow write: if isTeacherOfClass(classId);
    }

    // 클래스 학생 상태
    match /classes/{classId}/students_v2/{sid} {
      allow read:  if isAuthed();
      allow write: if isTeacherOfClass(classId) || (isAuthed() && classMappedSid(classId) == sid);
    }

    // 클래스 입장 신청
    match /classes/{classId}/join_requests/{email} {
      allow get:            if isTeacherOfClass(classId) || (isAuthed() && myEmail() == email);
      allow list:           if isTeacherOfClass(classId);
      allow create, update: if isAuthed() && myEmail() == email && request.resource.data.email == email;
      allow delete:         if isTeacherOfClass(classId) || (isAuthed() && myEmail() == email);
    }
  }
}
